{
  "name": "compound",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "format": "prettier --write .",
    "test": "jest",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > src/data/database.types.ts",
    "gen:sql-vectors": "node scripts/gen-sql-vectors.mjs",
    "check": "tsc --noEmit && expo lint && jest"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@expo-google-fonts/inter": "^0.4.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-google-signin/google-signin": "^17.0.0",
    "@sentry/react-native": "~8.28.0",
    "@shopify/react-native-skia": "2.14.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/query-async-storage-persister": "^5.108.0",
    "@tanstack/react-query": "^5.108.0",
    "@tanstack/react-query-persist-client": "^5.108.0",
    "date-fns": "^4.4.0",
    "expo": "~58.0.26",
    "expo-apple-authentication": "~58.0.3",
    "expo-application": "~58.1.2",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.21",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "lucide-react-native": "^1.75.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-worklets": "0.13.0",
    "victory-native": "^42.0.1"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts?(x)"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg|@date-fns/.*|date-fns)"
    ]
  }
}
