# Supabase (Project Settings → API). Never put the service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Sign-In (Google Cloud Console → Credentials → OAuth client IDs)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
# Reversed iOS client id, used by the native config plugin (com.googleusercontent.apps.xxxxxxxx)
GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.xxxxxxxx

# Sentry (optional; app is a no-op without it)
EXPO_PUBLIC_SENTRY_DSN=

# Legal pages
EXPO_PUBLIC_TERMS_URL=https://example.com/terms
EXPO_PUBLIC_PRIVACY_URL=https://example.com/privacy

# Expo Application Services (from `eas init`)
EAS_PROJECT_ID=
EAS_OWNER=
